# Copy to functions/.env (ignored by git) and fill in. Never commit the real values.

# SendGrid API key with only the "Mail Send" permission.
SENDGRID_API_KEY=
# The sender address verified in SendGrid (Settings > Sender Authentication > Single Sender).
MAIL_FROM=
# Shared with the dispatcher (Docker secret mail_token). Generate with: openssl rand -hex 32
MAIL_TOKEN=
